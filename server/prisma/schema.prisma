generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  new
  confirmed
  shipped
  done
  cancelled
}

enum PaymentMethod {
  cod
  card
}

enum PaymentStatus {
  pending
  paid
  failed
}

model Product {
  id           String   @id @default(uuid())
  title        String
  variantName  String?
  brand        String?
  category     String?
  packLabel    String?
  pcs          Int?
  sizeMl       Int?
  price        Decimal  @db.Decimal(10, 2)
  description  String?  @db.Text
  imageUrl     String?
  // Real inventory count. inStock (shown to shoppers) is derived as stockQty > 0
  // — there's deliberately no separate boolean to keep out of sync with reality.
  stockQty     Int      @default(0)
  tag          String?
  groupId      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orderItems   OrderItem[]
  stockAudits  StockAudit[]
  priceTiers   ProductPriceTier[]

  @@index([category])
  @@index([brand])
  @@index([groupId])
}

// A wholesale bulk-buy level for a product (e.g. "box of 10 packs", "pallet
// of 1000 packs"). unitQty is expressed in the product's own retail unit
// (its packLabel/pcs), not raw pieces, so admins reason about it the same
// way they already reason about the product. Price is admin-entered per
// tier (bulk pricing is usually negotiated/rounded, not a clean formula)
// rather than derived from Product.price.
model ProductPriceTier {
  id         String   @id @default(uuid())
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId  String
  label      String
  unitQty    Int
  price      Decimal  @db.Decimal(10, 2)
  moqTiers   Int      @default(1)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([productId])
}

model WholesaleQuote {
  id           String   @id @default(uuid())
  businessName String
  email        String
  businessType String
  estVolume    String?
  createdAt    DateTime @default(now())
}

model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  email     String
  category  String
  message   String   @db.Text
  createdAt DateTime @default(now())
}

model Order {
  id            String        @id @default(uuid())
  customerName  String
  customerPhone String
  customerAddress String
  customerNote  String?
  total         Decimal       @db.Decimal(10, 2)
  status        OrderStatus   @default(new)

  paymentMethod PaymentMethod @default(cod)
  paymentStatus PaymentStatus @default(pending)
  stripePaymentIntentId String? @unique

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  items         OrderItem[]

  @@index([status])
  @@index([customerPhone])
  @@index([customerName])
  @@index([createdAt])
}

model OrderItem {
  id          String   @id @default(uuid())
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId     String
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productId   String?
  title       String
  variantName String?
  price       Decimal  @db.Decimal(10, 2)
  qty         Int

  @@index([orderId])
}

// One row per "revision" / stock count an admin performs on a product:
// what the system said the quantity was vs. what was actually counted.
// Saving one of these also reconciles Product.stockQty to the counted value.
model StockAudit {
  id         String   @id @default(uuid())
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId  String
  systemQty  Int
  countedQty Int
  difference Int
  note       String?
  createdAt  DateTime @default(now())

  @@index([productId])
  @@index([createdAt])
}
